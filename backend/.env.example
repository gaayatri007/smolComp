MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/smolcomp?retryWrites=true&w=majority
DB_NAME=smolcomp
JWT_SECRET=replace-with-a-long-random-secret
# Optional; checkout is disabled until a Stripe test key is configured.
STRIPE_API_KEY=
# Optional; set this to verify Stripe webhook events.
STRIPE_WEBHOOK_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_USERS=false

# Optional; required only for the configured object-storage integration.
EMERGENT_LLM_KEY=
